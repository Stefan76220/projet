    {
      "id": "part",
      "label": "Partie",
      "default_zone": "bodymatter",
      "frequency": "courant",
      "aliases": [
        "partie",
        "part",
        "livre",
        "book",
        "volume"
      ],
      "title_regex": [
        "^(partie|part|livre|book|volume)\\s+([ivxlcdm]+|\\d+|[a-z]+)?\\b"
      ],
      "recognition": [
        "niveau hiérarchique supérieur aux chapitres",
        "contient plusieurs chapitres",
        "style répété"
