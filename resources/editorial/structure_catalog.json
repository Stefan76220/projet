{
  "schema": "tomelinea.editorial_structure_catalog.v1",
  "version": "1.0",
  "principle": {
    "autonomy": "TomeLinea classe automatiquement quand la structure et le type sont suffisamment certains.",
    "ambiguity": "Si une frontière structurelle paraît réelle mais que son type n'est pas identifiable avec assez de confiance, demander à l'utilisateur s'il faut créer une section et comment l'appeler.",
    "do_not_overask": "Un simple titre interne à un chapitre ne déclenche pas de question si aucune vraie frontière de section n'est détectée."
  },
  "top_level_model": [
    {
      "id": "front_cover",
      "label": "Couverture avant",
      "physical_faces": [
        "1re",
        "2e"
      ]
    },
    {
      "id": "interior",
      "label": "Intérieur",
      "children": [
        "frontmatter",
        "bodymatter",
        "backmatter"
      ]
    },
    {
      "id": "back_cover",
      "label": "Couverture arrière",
      "physical_faces": [
        "3e",
        "4e"
      ]
    }
  ],
  "interior_zones": {
    "frontmatter": "Pages liminaires",
    "bodymatter": "Corps",
    "backmatter": "Fin d’ouvrage"
  },
  "scoring": {
    "semantic_auto_threshold": 80,
    "semantic_ask_threshold": 55,
    "boundary_threshold": 70,
    "weights": {
      "exact_or_normalized_alias": 60,
      "position_consistent": 15,
      "heading_style": 10,
      "page_or_section_break": 8,
      "toc_or_bookmark_match": 10,
      "content_signature": 15,
      "repeated_structural_pattern": 15,
      "position_contradiction": -30,
      "hierarchy_contradiction": -35
    }
  },
  "known_types": [
    {
      "id": "halftitle",
      "label": "Faux-titre",
      "default_zone": "frontmatter",
      "frequency": "fréquent",
      "aliases": [
        "faux-titre",
        "faux titre",
        "half title",
        "halftitle"
      ],
      "recognition": [
        "page très courte",
        "titre seul ou presque",
        "avant la page de titre",
        "souvent nouvelle page"
      ]
    },
    {
      "id": "titlepage",
      "label": "Page de titre",
      "default_zone": "frontmatter",
      "frequency": "très fréquent",
      "aliases": [
        "page de titre",
        "title page"
      ],
      "recognition": [
        "titre du livre + auteur",
        "souvent sous-titre",
        "éditeur ou logo possible",
        "avant le corps"
      ]
    },
    {
      "id": "copyright",
      "label": "Mentions légales",
      "default_zone": "frontmatter",
      "frequency": "très fréquent",
      "aliases": [
