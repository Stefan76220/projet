  "fallback_rule": {
    "when": "frontière structurelle probable >= boundary_threshold mais aucun type connu n'atteint semantic_auto_threshold",
    "ui_question": "TomeLinea a repéré une nouvelle section : « {detected_title} ». Faut-il créer une section distincte ?",
    "choices": [
      "Créer la section",
      "Garder dans la section actuelle"
    ],
    "if_create": {
      "suggested_name": "{detected_title}",
      "ask_name": true,
      "internal_type": "custom_section",
      "zone": "déduite de la position ; si elle reste ambiguë, demander Début / Corps / Fin d’ouvrage"
    }
  },
  "test_fixture": {
    "file": "TL_TEST_STRUCTURE_REELLE_FREQUENTE.docx",
    "goal": "Tester des cas courants avec une source Word réaliste : mêmes styles Titre 1 pour de nombreuses unités, chapitres numérotés et non numérotés, une unité inconnue volontaire.",
    "expected": {
      "Pages liminaires": [
        "Mentions légales",
        "Dédicace",
        "Épigraphe",
        "Sommaire",
        "Avant-propos",
        "Préface",
        "Introduction"
      ],
      "Corps": [
        "PARTIE I — SE SOUVENIR",
        "Chapitre 1 — Les traces",
        "Chapitre 2 — Les récits",
        "PARTIE II — TRANSMETTRE",
        "Les gestes",
        "Les lieux"
      ],
      "Fin d’ouvrage": [
        "Conclusion",
        "Annexe A — Grille d’entretien",
        "Notes",
        "Bibliographie",
        "Glossaire",
        "Index",
        "Remerciements",
        "À propos de l’autrice",
        "Achevé d’imprimer"
      ],
      "must_ask": [
        "Carnet de terrain"
      ]
    }
  }
