        "dépôt légal",
        "éditeur",
        "imprimé",
        "impression à la demande"
      ]
    },
    {
      "id": "dedication",
      "label": "Dédicace",
      "default_zone": "frontmatter",
      "frequency": "courant",
      "aliases": [
        "dédicace",
        "dedicace",
        "dedication"
      ],
      "recognition": [
        "page courte",
        "souvent centrée",
        "formules comme « À… »"
      ]
    },
    {
      "id": "epigraph",
      "label": "Épigraphe",
      "default_zone": "frontmatter",
      "frequency": "courant",
      "aliases": [
        "épigraphe",
        "epigraphe",
        "epigraph"
      ],
      "recognition": [
        "citation courte",
        "attribution possible",
        "avant le corps ou une grande division"
