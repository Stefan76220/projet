      "default_zone": "frontmatter",
      "frequency": "très fréquent en non-fiction",
      "aliases": [
        "sommaire",
        "table des matières",
        "table de matières",
        "contents",
        "table of contents"
      ],
      "recognition": [
        "suite de titres + numéros de page",
        "champ Word TOC",
        "liens internes ou tabulations répétées"
